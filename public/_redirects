/tools/power-calculator/      /tools/electric-power-calculator/       301

# Stale phantom URL from an old crawl (nothing links to it) → send to the tools
# hub (the homepage) instead of a 404. Both slash forms, since crawlers hit both.
/tools/tools                  /                                       301
/tools/tools/                 /                                       301

