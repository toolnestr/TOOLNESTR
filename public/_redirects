# NOTE: www → apex canonical redirect is handled by a Cloudflare *Redirect Rule*
# (zone: toolnestr.com), NOT here — Cloudflare Pages _redirects only matches on
# path, not hostname, so a www rule in this file is ignored. See GSC-AUDIT-TRACKING.md.
#
# IMPORTANT: Cloudflare Pages matches _redirects on the EXACT path, and does NOT
# fold trailing slashes together. Our canonical URLs are the slash form, so the
# slash variant is the one most likely indexed — every removed slug therefore
# needs BOTH the no-slash and slash rule, or the slash form 404s.

# Removed tools → redirect to the Finance category so old/indexed links don't 404.
/tools/canada-net-salary-calculator       /tools/finance/   301
/tools/canada-net-salary-calculator/      /tools/finance/   301
/tools/netherlands-net-salary-calculator  /tools/finance/   301
/tools/netherlands-net-salary-calculator/ /tools/finance/   301

# Duplicate-slug consolidation (SEO) → 301 to the canonical, keyword-complete URL.
/tools/qr-generator           /tools/qr-code-generator              301
/tools/qr-generator/          /tools/qr-code-generator/             301
/tools/resistor-color-code    /tools/resistor-color-code-calculator 301
/tools/resistor-color-code/   /tools/resistor-color-code-calculator/ 301

