---
// Visible breadcrumb for the flagship tool pages, matching ToolLayout's trail so
// the whole site reads the same. Category is looked up from tools.js by slug, so
// it cannot drift from the tool's real category.
import { tools, categories } from '../data/tools.js';

const { slug, title, class: className = '' } = Astro.props;

const tool = tools.find((t) => t.slug === slug);
if (!tool) throw new Error(`ToolBreadcrumb: no tool with slug "${slug}" in tools.js`);
const category = categories.find((c) => c.id === tool.category);
if (!category) throw new Error(`ToolBreadcrumb: unknown category "${tool.category}" for "${slug}"`);

const label = title ?? tool.title;
---

<nav class:list={['tn-breadcrumb', className]} aria-label="Breadcrumb">
  <a href="/">Home</a>
  <span aria-hidden="true">›</span>
  <a href={`/tools/${category.id}/`}>{category.name}</a>
  <span aria-hidden="true">›</span>
  <span class="tn-breadcrumb-current">{label}</span>
</nav>

<style>
  /* Self-contained: the flagship pages each define their own design tokens, so
     this must not depend on any of them. */
  .tn-breadcrumb {
    max-width: 1100px;
    margin: 0 auto;
    padding: 16px 20px 0;
    font-size: 13px;
    line-height: 1.5;
    color: #64748b;
  }
  .tn-breadcrumb a {
    color: inherit;
    text-decoration: none;
  }
  .tn-breadcrumb a:hover {
    color: #4f46e5;
    text-decoration: underline;
  }
  .tn-breadcrumb span {
    margin: 0 5px;
  }
  .tn-breadcrumb-current {
    color: #334155;
    margin-left: 0;
  }
  :global(.dark) .tn-breadcrumb {
    color: #94a3b8;
  }
  :global(.dark) .tn-breadcrumb-current {
    color: #cbd5e1;
  }
  :global(.dark) .tn-breadcrumb a:hover {
    color: #818cf8;
  }
</style>
