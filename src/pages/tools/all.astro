---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories, tools } from '../../data/tools.js';
import { site } from '../../data/site.js';

const liveTools = tools.filter((t) => t.enabled && t.status === 'live');

// Group live tools by category
const categorizedTools = categories.map((cat) => ({
  ...cat,
  tools: liveTools.filter((t) => t.category === cat.id),
})).filter((cat) => cat.tools.length > 0);

const pageTitle = `All Tools Directory (${liveTools.length}+ Free Utilities) — ${site.name}`;
const pageDesc = `Complete directory of all ${liveTools.length}+ free online tools, calculators, and converters on ${site.name}. Browse by category. 100% private, browser-based, and no sign-up required.`;
const pageUrl = `${site.url}/tools/all/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: pageTitle,
      description: pageDesc,
      isPartOf: { '@id': `${site.url}/#organization` },
      about: { '@id': `${site.url}/#organization` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
        { '@type': 'ListItem', position: 2, name: 'Tools', item: `${site.url}/tools/` },
        { '@type': 'ListItem', position: 3, name: 'All Tools Directory', item: pageUrl },
      ],
    },
    {
      '@type': 'ItemList',
      numberOfItems: liveTools.length,
      itemListElement: liveTools.map((t, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        url: `${site.url}/tools/${t.slug}/`,
        name: t.title,
        description: t.short,
      })),
    },
  ],
};
---

<BaseLayout title={pageTitle} description={pageDesc} jsonLd={jsonLd}>
  <!-- Hero banner -->
  <div class="relative overflow-hidden bg-gradient-to-br from-indigo-900 via-slate-900 to-indigo-950 text-white">
    <div class="pointer-events-none absolute -right-16 -top-16 h-80 w-80 rounded-full bg-indigo-500/20 blur-3xl"></div>
    <div class="pointer-events-none absolute -left-10 bottom-0 h-64 w-64 rounded-full bg-violet-500/20 blur-3xl"></div>

    <div class="relative mx-auto max-w-6xl px-4 py-12 sm:py-16">
      <nav class="mb-5 text-sm text-indigo-200/80" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white">Home</a>
        <span class="mx-1.5">›</span>
        <span class="text-white">All Tools Directory</span>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-indigo-400/30 bg-indigo-500/10 px-3.5 py-1 text-xs font-medium text-indigo-300 backdrop-blur-sm">
          <span>🗂️</span>
          <span>Complete Site Index · {liveTools.length} Live Tools · {categories.length} Categories</span>
        </div>
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-5xl">
          All Free Online Tools
        </h1>
        <p class="mt-3 text-lg leading-relaxed text-indigo-100/90">
          Every calculator, converter, generator, and technical utility on {site.name} in one place.
          All tools run directly in your browser with zero sign-up, zero data tracking, and zero fees.
        </p>

        <!-- Live Instant Search Filter -->
        <div class="mt-8">
          <div class="relative max-w-xl">
            <svg class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" />
            </svg>
            <input
              id="directory-filter"
              type="text"
              placeholder={`Filter all ${liveTools.length} tools instantly by keyword…`}
              class="w-full rounded-2xl border-0 bg-white py-3.5 pl-12 pr-4 text-sm text-slate-800 shadow-xl shadow-black/20 outline-none ring-2 ring-indigo-400/50 transition placeholder:text-slate-400 focus:ring-indigo-400 dark:bg-slate-800 dark:text-slate-100"
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Category Jump Navigation (Sticky Pills) -->
  <div class="sticky top-14 z-20 border-b border-slate-200 bg-white/95 px-4 py-3 backdrop-blur-md dark:border-slate-800 dark:bg-slate-900/95">
    <div class="mx-auto flex max-w-6xl items-center gap-2 overflow-x-auto pb-1 text-xs sm:text-sm">
      <span class="shrink-0 font-semibold text-slate-500 dark:text-slate-400">Jump to:</span>
      {categorizedTools.map((cat) => (
        <a
          href={`#cat-${cat.id}`}
          class="shrink-0 rounded-full border border-slate-200 bg-slate-50 px-3 py-1 font-medium text-slate-700 transition hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:border-indigo-500/50 dark:hover:bg-slate-700 dark:hover:text-white"
        >
          {cat.emoji} {cat.name} ({cat.tools.length})
        </a>
      ))}
    </div>
  </div>

  <!-- Main Directory Body -->
  <main class="mx-auto max-w-6xl px-4 py-12">
    <p id="filter-empty" class="hidden py-16 text-center text-base text-slate-500 dark:text-slate-400">
      No tools match your filter. Try searching for something else or browse categories below.
    </p>

    <div class="space-y-16">
      {categorizedTools.map((cat) => (
        <section id={`cat-${cat.id}`} class="category-block scroll-mt-32">
          <div class="flex flex-col gap-2 border-b border-slate-200 pb-4 sm:flex-row sm:items-center sm:justify-between dark:border-slate-800">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-2xl dark:bg-slate-800">
                {cat.emoji}
              </span>
              <div>
                <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
                  {cat.name}
                </h2>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                  <span class="cat-visible-count">{cat.tools.length}</span> of {cat.tools.length} tools
                </p>
              </div>
            </div>
            <a
              href={`/tools/${cat.id}/`}
              class="inline-flex items-center gap-1 text-sm font-semibold text-indigo-600 transition hover:text-indigo-800 dark:text-indigo-400 dark:hover:text-indigo-300"
            >
              Explore {cat.name} Category Hub →
            </a>
          </div>

          <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {cat.tools.map((t) => (
              <a
                href={`/tools/${t.slug}/`}
                data-tool-title={t.title.toLowerCase()}
                data-tool-desc={(t.short || '').toLowerCase()}
                data-tool-slug={t.slug.toLowerCase()}
                class="tool-item group flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-3.5 shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900/60 dark:hover:border-indigo-500/40"
              >
                <div>
                  <div class="flex items-center gap-2">
                    <span class="text-xl">{t.emoji}</span>
                    <h3 class="truncate text-sm font-semibold text-slate-900 group-hover:text-indigo-600 dark:text-white dark:group-hover:text-indigo-400">
                      {t.title}
                    </h3>
                  </div>
                  <p class="mt-1.5 line-clamp-2 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
                    {t.short}
                  </p>
                </div>
                <div class="mt-3 flex items-center justify-between border-t border-slate-100 pt-2 text-[11px] text-slate-400 dark:border-slate-800/80">
                  <span class="font-mono text-[10px] text-slate-400">/tools/{t.slug}/</span>
                  <span class="font-medium text-indigo-600 group-hover:translate-x-0.5 transition dark:text-indigo-400">Open &rarr;</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>

  <script is:inline>
    // Live Directory Filter
    const filterInput = document.getElementById('directory-filter');
    const items = Array.from(document.querySelectorAll('.tool-item'));
    const categories = Array.from(document.querySelectorAll('.category-block'));
    const emptyMsg = document.getElementById('filter-empty');

    if (filterInput) {
      filterInput.addEventListener('input', (e) => {
        const q = e.target.value.trim().toLowerCase();
        let totalVisible = 0;

        categories.forEach((cat) => {
          const catTools = Array.from(cat.querySelectorAll('.tool-item'));
          let catVisible = 0;

          catTools.forEach((item) => {
            const title = item.getAttribute('data-tool-title') || '';
            const desc = item.getAttribute('data-tool-desc') || '';
            const slug = item.getAttribute('data-tool-slug') || '';
            const match = !q || title.includes(q) || desc.includes(q) || slug.includes(q);

            item.classList.toggle('hidden', !match);
            if (match) catVisible++;
          });

          // Update category visibility and counter
          cat.classList.toggle('hidden', catVisible === 0);
          const counter = cat.querySelector('.cat-visible-count');
          if (counter) counter.textContent = catVisible;

          totalVisible += catVisible;
        });

        if (emptyMsg) {
          emptyMsg.classList.toggle('hidden', totalVisible > 0);
        }
      });
    }
  </script>
</BaseLayout>
